<?xml version="1.0" encoding="utf-8"?>
<!-- 软件包版本号定义。

发布版本号说明：
release元素的version属性，配置发布版本号。
同一主干同一套源码同一版本同一时刻构建出来的各包版本号必须保持一致，
因此统一的版本号没有必要按照包的配置版本号信息。

版本兼容配置说明：
package/compatible/item元素，配置兼容版本号。例如以下配置，表明安装时firmware包兼容driver包的1.79版本。
    <package name="firmware">
        <compatible>
            <item name="driver" version="1.79"/>
        </compatible>
    </package>

版本兼容区间语法如下：
a.b 表示兼容指定唯一版本
[a.b, c.d] 表示兼容版本范围，a.b=<version<=c.d
[a.b] 表示兼容版本范围，version>=a.b
(a.b] 表示兼容版本范围，version>a.b
[,c.d] 表示兼容版本范围，version<=c.d
[,c.d) 表示兼容版本范围，version<c.d
针对需要兼容多个版本，且这些版本不在一个连续区间时，采用多行来表示，如driver兼容runtime 5.3、5.5、5.6和5.7版本，可表示为：
    <package name="driver"
        <compatible>
            ...
            <item name="runtime" version="5.3">
            <item name="runtime" version="[5.5,5.7]">
            ...
        <compatible>
    <package>

-->
<release version="package/ops_transformer/sys_version.conf" version_dir="$(CUR_VER).RC1">
    <!--各包在当前version下配套的其他版本包的版本号关系维护表-->
    <!--firmware包只需要检查driver包-->
    <package name="firmware">
        <compatible>
            <item name="driver" version=""/>
        </compatible>
    </package>
    <!--driver包需要检查firmware、runtime-->
    <package name="driver">
        <compatible>
            <item name="firmware" version=""/>
            <item name="runtime" version=""/>
        </compatible>
    </package>
    <!--runtime包需要检查driver、compiler...-->
    <package name="runtime">
        <compatible>
            <item name="driver" version=""/>
            <item name="compiler" version="$(CUR_VER)"/>
            <item name="hccl" version="$(CUR_VER)"/>
            <item name="fwkplugin" version="$(CUR_VER)"/>
            <item name="toolkit" version="$(CUR_VER)"/>
            <item name="opp" version="$(CUR_VER)"/>
            <item name="amct_acl" version="$(CUR_VER)"/>
            <item name="nca" version="$(CUR_VER)"/>
            <item name="ncs" version="$(CUR_VER)"/>
            <item name="aoe" version="$(CUR_VER)"/>
            <item name="opp_kernel" version="[7.6, $(CUR_VER)]"/>
        </compatible>
    </package>
    <!--3-8包之间互相检查-->
    <package name="compiler">
        <compatible>
            <item name="runtime" version="$(CUR_VER)"/>
